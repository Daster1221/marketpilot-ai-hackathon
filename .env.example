# Telegram bot created through @BotFather
TELEGRAM_BOT_TOKEN=
# Allowed Telegram user IDs (comma-separated); blank denies everyone.
TELEGRAM_OWNER_ID=
# Optional until you want to publish to your test channel
TELEGRAM_CHANNEL_ID=
# Public HTTPS address of the Mini App placeholder
MINI_APP_URL=
# DeepSeek API key, not a Telegram token
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.proxyapi.ru/v1
DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
# Salavatsteklo brand spelling: brandbook or editorial
BRAND_NAME_MODE=editorial
# Local speech recognition; audio is not sent to ProxyAPI
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# ID проверенной группы для Premium-эмодзи (не канала)
TELEGRAM_PREMIUM_GROUP_ID=

# Управление пользователями: по умолчанию первый ID из TELEGRAM_OWNER_ID
TELEGRAM_ADMIN_ID=
